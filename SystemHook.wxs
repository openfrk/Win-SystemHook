<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SystemHook" Manufacturer="FRK Studios" Version="1.0.0.0" UpgradeCode="B4D7B3A1-2C4F-4A8E-9F1B-3D5E7A9C2B6F">
    
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SystemHook" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="SystemHookExe" Guid="*">
        <File Id="SystemHook.exe" Source="SystemHook.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="SystemHook" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>